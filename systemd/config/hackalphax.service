[Unit]
Description=HackAlphaX Website
After=network-online.target

[Service]
Type=simple
WorkingDirectory=/home/ubuntu/hosting/apps/hackalphax
ExecStart=/home/ubuntu/.local/bin/poetry run gunicorn main:app --bind 0.0.0.0:8000
Restart=on-failure
RestartSec=60
User=ubuntu
Group=ubuntu

[Install]
WantedBy=multi-user.target
